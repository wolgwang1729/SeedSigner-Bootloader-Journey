+// ---------------------------------------------------------------------------
+// Phase 19 G2: early warm-reset canary inspector.
+// Runs BEFORE load_firmware_from_sd() (any PSRAM/SD alloc destroys evidence).
+// Reads the fixed canary window with a constant-time volatile word loop
+// (no memcmp), logs REMANENT vs CLEARED, zeroes the local read buffer,
+// clears the RTC test flag, and returns. Normal boots skip the read.
+// ---------------------------------------------------------------------------
+#if CONFIG_IDF_TARGET_ESP32P4
+#define TEST_MAGIC_ADDR ((volatile uint32_t *)0x5010FFF0)
+#elif CONFIG_IDF_TARGET_ESP32S3
+#define TEST_MAGIC_ADDR ((volatile uint32_t *)0x600FFFF0)
+#else
+#define TEST_MAGIC_ADDR ((volatile uint32_t *)0x0)
+#endif
+
+// Inspector streaming chunk (bytes). Keeps the G4 evidence-handling
+// property with bounded stack while covering the 1 MB window.
+#define INSPECT_CHUNK 256
+
+static void inspect_canary_early(void)
+{
+    esp_reset_reason_t reason = esp_reset_reason();
+    int warm = (reason == ESP_RST_SW || reason == ESP_RST_PANIC ||
+                reason == ESP_RST_INT_WDT || reason == ESP_RST_TASK_WDT ||
+                reason == ESP_RST_WDT);
+    if (!warm) {
+        return;
+    }
+    volatile uint32_t *magic = TEST_MAGIC_ADDR;
+    uint32_t m = *magic;
+    if (m != RTC_TEST_MAGIC) {
+        return;
+    }
+
+    // Volatile word-by-word inspect over the full 1 MB window, streamed
+    // through a 256 B stack chunk (constant-time-ish, no early exit for
+    // the CLEARED determination). The cyclic chunk preserves the G4
+    // property (no unscrubbed evidence copy) with O(256 B) stack.
+    volatile uint32_t *canary = (volatile uint32_t *)CANARY_PADDR;
+    const size_t words = CANARY_LEN / 4;
+    uint8_t chunk[INSPECT_CHUNK];
+    uint32_t nonzero = 0;
+    uint32_t first_off = 0;
+    uint32_t first_word = 0;
+    int have_first = 0;
+    for (size_t i = 0; i < words; i++) {
+        uint32_t w = canary[i];
+        // Fold into the cyclic chunk byte-wise (evidence handling).
+        chunk[(i * 4 + 0) % INSPECT_CHUNK] = (uint8_t)(w & 0xFF);
+        chunk[(i * 4 + 1) % INSPECT_CHUNK] = (uint8_t)((w >> 8) & 0xFF);
+        chunk[(i * 4 + 2) % INSPECT_CHUNK] = (uint8_t)((w >> 16) & 0xFF);
+        chunk[(i * 4 + 3) % INSPECT_CHUNK] = (uint8_t)((w >> 24) & 0xFF);
+        if (w != 0) {
+            if (!have_first) {
+                first_off = (uint32_t)(i * 4);
+                first_word = w;
+                have_first = 1;
+            }
+            nonzero++;
+        }
+        if (((i + 1) % (INSPECT_CHUNK / 4)) == 0) {
+            memzero(chunk, sizeof(chunk));
+        }
+    }
+    if (nonzero == 0) {
+        ESP_LOGI(TAG, "INSPECT Canary 0x%08lX: CANARY_CLEARED (%d/%d zero)",
+                 (unsigned long)CANARY_PADDR, (int)CANARY_LEN, (int)CANARY_LEN);
+    } else {
+        ESP_LOGI(TAG, "INSPECT Canary 0x%08lX: CANARY_REMANENT "
+                      "(non-zero words=%lu first at +0x%lX first_word=0x%08lX)",
+                 (unsigned long)CANARY_PADDR, (unsigned long)nonzero,
+                 (unsigned long)first_off,
+                 (unsigned long)first_word);
+    }
+    // Zero the chunk (G4) and clear the test flag so normal boots skip.
+    memzero(chunk, sizeof(chunk));
+    *magic = 0;
+}
+
+// ---------------------------------------------------------------------------
+// Phase 19 G3: bounded pre-verify jitter (1–5 ms, every boot, not fail-only
+// so there is no timing oracle). Returns the applied delay for the log.
+// ---------------------------------------------------------------------------
+static uint32_t apply_verify_jitter_ms(void)
+{
+    uint32_t r = 0;
+    esp_fill_random(&r, sizeof(r));
+    uint32_t ms = GLITCH_JITTER_MIN_MS +
+        (r % (GLITCH_JITTER_MAX_MS - GLITCH_JITTER_MIN_MS + 1));
+    vTaskDelay(ms / portTICK_PERIOD_MS);
+    return ms;
+}
