+// ---------------------------------------------------------------------------
+// Phase 19 G4: fail-closed halt helper. Scrubs every secret-adjacent buffer
+// with the barrier-safe volatile loop (never memset) before halting.
+// ---------------------------------------------------------------------------
+static void halt_and_scrub(uint8_t *psram_buf, size_t fw_size,
+                           image_plan_t *plan,
+                           uint8_t *inspector_buf, size_t inspector_len)
+{
+    if (psram_buf && fw_size > 0) {
+        memzero(psram_buf, fw_size);
+    }
+    if (plan) {
+        memzero(plan, sizeof(*plan));
+    }
+    if (inspector_buf && inspector_len > 0) {
+        memzero(inspector_buf, inspector_len);
+    }
+    while (1) vTaskDelay(1000 / portTICK_PERIOD_MS);
