@@ -35,6 +36,33 @@ esp_err_t bundle_validate_sig_section(const uint8_t *psram_buf, size_t fw_size,
                                        uint32_t main_pl_size,
                                        const bl_section_t **out_sig_hdr);
 
+// ---------------------------------------------------------------------------
+// Phase 19 (G3): glitch-hardening status wrapper. Pure + host-testable.
+// ---------------------------------------------------------------------------
+// Hamming-separated magic status: a random single-bit fault cannot turn
+// SECURE_FAIL into SECURE_OK (needs all 16 bits flipped).
+typedef uint16_t secure_status_t;
+
+// Convert an esp_err_t gate result to magic immediately at the call site.
+static inline secure_status_t bundle_status_from_esp(esp_err_t err) {
+  return (err == ESP_OK) ? SECURE_OK : SECURE_FAIL;
+}
+
+// Convert a boolean gate result to magic immediately at the call site.
+static inline secure_status_t bundle_status_from_bool(int ok) {
+  return ok ? SECURE_OK : SECURE_FAIL;
+}
+
+// Double-branch check: returns 1 iff BOTH volatile reads equal SECURE_OK
+// with a compiler barrier between them. A single instruction-skip defeats
+// at most one branch. Callers must still halt+scrub on 0.
+static inline int secure_check_double(volatile secure_status_t *st) {
+  int first = (*st == SECURE_OK);
+  __asm__ volatile("" ::: "memory");
+  int second = (*st == SECURE_OK);
+  return (first && second);
+}
+
 #ifdef __cplusplus
 }
 #endif
