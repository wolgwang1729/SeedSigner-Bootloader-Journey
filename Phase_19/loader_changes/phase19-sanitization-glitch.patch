+// turn FAIL into OK. Compared as volatile with a compiler barrier between
+// the two branches (double-branch) to defeat single instruction-skip.
+#define SECURE_OK   ((uint16_t)0x5A5A)
+#define SECURE_FAIL ((uint16_t)0xA5A5)
