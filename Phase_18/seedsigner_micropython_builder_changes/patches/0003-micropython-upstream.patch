diff --git a/ports/esp32/main.c b/ports/esp32/main.c
index 0451a11b1..42900d5ec 100644
--- a/ports/esp32/main.c
+++ b/ports/esp32/main.c
@@ -48,6 +48,8 @@
 #endif
 
 #include "py/cstack.h"
+#include "py/builtin.h" // mp_import_stat (stateless frozen-main fallback)
+#include "py/misc.h" // vstr (stateless embedded launcher)
 #include "py/nlr.h"
 #include "py/compile.h"
 #include "py/runtime.h"
@@ -157,7 +159,16 @@ soft_reset:
     #endif
 
     // run boot-up scripts
+    #ifdef CONFIG_STATELESS_PSARAM_EXECUTION
+    // Stateless PSRAM execution: no flash filesystem exists by design, so the
+    // stock mount-or-inisetup flow must not run — it misfires on phantom flash
+    // partitions (once reaching a flash erase through one) and its OTA helper
+    // aborts on PSRAM addresses. Just collect; boot.py/main.py are attempted
+    // from VFS below (absent -> frozen stateless_main launcher). Local experiment.
+    gc_collect();
+    #else
     pyexec_frozen_module("_boot.py", false);
+    #endif
     int ret = pyexec_file_if_exists("boot.py");
 
     #if MICROPY_HW_ENABLE_USBDEV
@@ -172,6 +183,66 @@ soft_reset:
         if (ret & PYEXEC_FORCED_EXIT) {
             goto soft_reset_exit;
         }
+        #ifdef CONFIG_STATELESS_PSARAM_EXECUTION
+        // Stateless boot has no flash filesystem, so VFS main.py is absent —
+        // execute the embedded SeedSigner launcher instead (same body as
+        // tools/_launcher.py MAIN_PY). Embedded as C source rather than a
+        // frozen module so no frozen-table lookup is involved. Local experiment.
+        {
+            static const char stateless_main_src[] =
+                "import sys\n"
+                "sys.path.insert(0, '/overlay')\n"
+                "import time\n"
+                "print('[boot-ms] main.py start:', time.ticks_ms())\n"
+                "try:\n"
+                "    import gc\n"
+                "    gc.collect()\n"
+                "    print('[boot-ms] gc free/alloc pre-import:', gc.mem_free(), gc.mem_alloc())\n"
+                "    _probe = None\n"
+                "    _n = 1 << 20\n"
+                "    while _n >= (1 << 12):\n"
+                "        try:\n"
+                "            _probe = bytearray(_n)\n"
+                "            print('[boot-ms] probe bytearray', _n, 'OK')\n"
+                "            del _probe\n"
+                "            break\n"
+                "        except MemoryError:\n"
+                "            print('[boot-ms] probe bytearray', _n, 'FAIL')\n"
+                "            _n //= 2\n"
+                "    _held = []\n"
+                "    _total = 0\n"
+                "    try:\n"
+                "        while True:\n"
+                "            _held.append(bytearray(1024))\n"
+                "            _total += 1024\n"
+                "    except MemoryError:\n"
+                "        print('[boot-ms] fill total 1KB blocks:', _total)\n"
+                "    del _held\n"
+                "    gc.collect()\n"
+                "    from seedsigner.controller import Controller\n"
+                "    print('[boot-ms] controller import done:', time.ticks_ms())\n"
+                "    _c = Controller.get_instance()\n"
+                "    print('[boot-ms] controller instance ready, calling start():', time.ticks_ms())\n"
+                "    _c.start()\n"
+                "except Exception as e:\n"
+                "    sys.print_exception(e)\n"
+                "    try:\n"
+                "        import gc as _gc\n"
+                "        print('[boot-ms] gc free/alloc post-fail:', _gc.mem_free(), _gc.mem_alloc())\n"
+                "    except Exception:\n"
+                "        pass\n"
+                "    print('[main] Controller exited via exception; dropping to REPL.')\n";
+            vstr_t vstr;
+            vstr_init(&vstr, sizeof(stateless_main_src));
+            vstr_add_str(&vstr, stateless_main_src);
+            if (pyexec_vstr(&vstr, true) & PYEXEC_FORCED_EXIT) {
+                goto soft_reset_exit;
+            }
+        }
+        #else
+        // Stock behaviour: without VFS main.py there is nothing more to run.
+        (void)0;
+        #endif
     }
 
     for (;;) {
diff --git a/ports/esp32/uart.c b/ports/esp32/uart.c
index 6e00fa3aa..164531ced 100644
--- a/ports/esp32/uart.c
+++ b/ports/esp32/uart.c
@@ -67,6 +67,16 @@ void uart_stdout_init(void) {
     uart_hal_rxfifo_rst(&repl_hal);
     uart_hal_txfifo_rst(&repl_hal);
 
+    // Headless E2E (LOCAL dirty-tree experiment, NOT for upstream): do NOT
+    // register MicroPython's UART RX ISR and do NOT enable RX interrupts.
+    // MP's uart_irq_handler drains every received byte from the HW FIFO into
+    // its private stdin_ringbuf, starving the IDF UART driver that backs VFS
+    // stdin — the hvfb console (fgets) then never receives dump/tap lines.
+    // With the ISR unhooked, the IDF driver owns RX and VFS stdin works;
+    // TX path above is untouched so all prints still flow. Cost: no UART REPL
+    // input and no Ctrl+C kbd-intr (reset button recovers the board).
+    // Original code kept below for review (do NOT merge as-is).
+#if 0
     ESP_ERROR_CHECK(
         esp_intr_alloc(uart_periph_signal[MICROPY_HW_UART_REPL].irq,
             ESP_INTR_FLAG_LOWMED | ESP_INTR_FLAG_IRAM,
@@ -79,6 +89,7 @@ void uart_stdout_init(void) {
     uart_hal_set_rxfifo_full_thr(&repl_hal, RXFIFO_FULL_THR);
     uart_hal_set_rx_timeout(&repl_hal, RXFIFO_RX_TIMEOUT);
     uart_hal_ena_intr_mask(&repl_hal, UART_INTR_RXFIFO_FULL | UART_INTR_RXFIFO_TOUT);
+#endif
 }
 
