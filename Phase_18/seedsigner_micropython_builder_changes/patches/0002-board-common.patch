@@ -1072,6 +1076,24 @@ static void lvgl_port_setup(const board_app_config_t *app_cfg,
     port_cfg.task_stack_caps  = MALLOC_CAP_SPIRAM;
     ESP_ERROR_CHECK(lvgl_port_init(&port_cfg));
 
+#ifdef HEADLESS_VIRTUAL_FB
+    /* Headless DEV-KIT (no panel): virtual display + emulated touch take over
+     * here so none of the panel-specific registration below runs. */
+    if (disp_out) {
+        *disp_out = NULL;
+    }
+    if (touch_out) {
+        *touch_out = NULL;
+    }
+    if (panel_handle == NULL) {
+        if (hvfb_init_ex(disp_out, touch_out, landscape ? 1 : 0) == 0) {
+            ESP_LOGI(TAG, "HEADLESS_VIRTUAL_FB active: display+touch virtualised");
+            return;
+        }
+        ESP_LOGW(TAG, "HEADLESS_VIRTUAL_FB init failed; falling back to panel path");
+    }
+#endif
+
