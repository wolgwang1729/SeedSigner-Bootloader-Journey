index c47a042..ae607f9 100644
--- a/deps/micropython/mods/new_files/ports/esp32/boards/WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_43/mpconfigboard.cmake
+++ b/deps/micropython/mods/new_files/ports/esp32/boards/WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_43/mpconfigboard.cmake
@@ -15,3 +15,12 @@ endif()
 # Freeze the SeedSigner app's required stdlib modules (logging + hmac, from
 # micropython-lib) into the firmware so they need not be vendored to /lib.
 set(MICROPY_FROZEN_MANIFEST ${MICROPY_BOARD_DIR}/manifest.py)
+
+# Stateless-loader entry: the shim replays early boot (clocks, MMU contexts,
+# init fns, PSRAM heap, CLIC vectors) after the loader's PSRAM-MMU JMP, then
+# hands off to esp_startup_start_app. GATED to the PRE_REV3_STATELESS variant:
+# the --wrap redirections (call_start_cpu0, heap caps, OTA stubs, ...) must
+# NOT leak into flash-execution firmware builds of this board.
+if(MICROPY_BOARD_VARIANT STREQUAL "PRE_REV3_STATELESS")
+    list(APPEND MICROPY_EXTRA_COMPONENT_DIRS "${MICROPY_BOARD_DIR}/stateless_shim")
+endif()
diff --git a/deps/micropython/mods/new_files/ports/esp32/boards/WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_43/sdkconfig.board b/deps/micropython/mods/new_files/ports/esp32/boards/WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_43/sdkconfig.board
index 53dcc2e..0dfb0da 100644
--- a/deps/micropython/mods/new_files/ports/esp32/boards/WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_43/sdkconfig.board
+++ b/deps/micropython/mods/new_files/ports/esp32/boards/WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_43/sdkconfig.board
@@ -255,3 +255,14 @@ CONFIG_MBEDTLS_RIPEMD160_C=y
 # ESP32-P4 only (Kconfig depends on IDF_TARGET_ESP32P4, default n). Tip from
 # odudex (cUR upstream); needs a cUR pin carrying the SIMD path (>= main 0ed276b).
 CONFIG_UR_XOR_ESP32P4_SIMD=y
+
+# ── Headless E2E (LOCAL experiment, flagged for Keith, NOT for upstream) ──
+# Console UART 921600 for the headless framebuffer stream (stock 115200 moves
+# one 768 KB frame in ~95 s; 921600 in ~12 s). Baud needs Custom UART0 on the
+# DEV-KIT's wired pins (U0TXD=37/U0RXD=38); wiring identical to default.
+# Match on host: fb_live.py --baud 921600. Restore before panel bring-up.
+CONFIG_ESP_CONSOLE_UART_CUSTOM=y
+CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
+CONFIG_ESP_CONSOLE_UART_TX_GPIO=37
+CONFIG_ESP_CONSOLE_UART_RX_GPIO=38
+CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
