diff --git a/main/stateless_ota.c b/main/stateless_ota.c
new file mode 100644
index 0000000..979e2a0
--- /dev/null
+++ b/main/stateless_ota.c
@@ -0,0 +1,37 @@
+// Phase 22 stateless compatibility shim.
+//
+// A stateless payload executes from PSRAM, not from its flash app partition.
+// esp_ota_get_running_partition() locates the running image by translating the
+// address of its own code through spi_flash_cache2phys(); that translation does
+// not describe a PSRAM XIP address and the function eventually aborts. IDF's
+// esp_partition_main_flash_region_safe() and Kern's fw_update_boot_confirm()
+// both call it, so return the payload's metadata app partition instead.
+
+#include "sdkconfig.h"
+
+#if CONFIG_KERN_STATELESS
+
+#include <esp_partition.h>
+
+static const esp_partition_t s_stateless_fallback = {
+    .flash_chip = NULL,
+    .type = ESP_PARTITION_TYPE_APP,
+    .subtype = ESP_PARTITION_SUBTYPE_APP_FACTORY,
+    .address = 0x30000,
+    .size = 0x200000,
+    .erase_size = 0x1000,
+    .label = "factory",
+    .encrypted = false,
+    .readonly = false,
+};
+
+const esp_partition_t *__wrap_esp_ota_get_running_partition(void) {
+  const esp_partition_t *part = esp_partition_find_first(
+      ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_ANY, NULL);
+  if (part != NULL) {
+    return part;
+  }
+  return &s_stateless_fallback;
+}
+
+#endif
diff --git a/partitions_stateless.csv b/partitions_stateless.csv
new file mode 100644
index 0000000..55f6d4d
--- /dev/null
+++ b/partitions_stateless.csv
@@ -0,0 +1,16 @@
+# Kern stateless payload partition table (Phase 22)
+#
+# The payload runs from a signed SD bundle and is not OTA-updated, so it has no
+# ota_0/ota_1 app partitions. The loader's own table stays at 0x20000; this one
+# lives in the free 0x10000 sector so the payload's esp_partition/NVS calls can
+# find their state partitions. Keep every offset out of the loader's regions:
+#   0x2000-0xC000 bootloader, 0x10000 ptable, 0x20000 loader ptable,
+#   0x21000-0x29000 loader NVS/efuse, 0x30000 loader app, 0x230000+ random_fill.
+nvs,     data, nvs,   0x11000, 0x7000
+otadata, data, ota,   0x1e000, 0x2000
+# Metadata-only app entry. IDF's esp_partition_main_flash_region_safe() calls
+# esp_ota_get_running_partition() and asserts when no app partition exists, so
+# NVS erase/write would otherwise abort. The payload actually executes from
+# PSRAM; this entry describes the loader's flash app slot so the safety check
+# has a non-NULL range. It is never booted or updated.
+factory, app,  factory, 0x30000, 0x200000
diff --git a/sdkconfig.defaults.stateless b/sdkconfig.defaults.stateless
new file mode 100644
index 0000000..5caaa74
--- /dev/null
+++ b/sdkconfig.defaults.stateless
@@ -0,0 +1,17 @@
+# Phase 22 Kern stateless handoff overlay (loader boots CPU0 only)
+CONFIG_FREERTOS_UNICORE=y
+CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y
+CONFIG_EFUSE_VIRTUAL=y
+CONFIG_EFUSE_VIRTUAL_LOG_ALL_WRITES=y
+CONFIG_SPIRAM_MEMTEST=n
+# The stateless loader verifies the payload bundle (Layer 2). Do not also run
+# IDF's secure-boot app check: the loader's eFuse key belongs to the loader,
+# not to this payload, so the check would abort in init_efuse().
+CONFIG_SECURE_BOOT=n
+CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=n
+CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=n
+# Stateless payload table in the loader's free 0x10000 sector: no OTA apps.
+CONFIG_PARTITION_TABLE_CUSTOM=y
+CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_stateless.csv"
+CONFIG_PARTITION_TABLE_OFFSET=0x10000
+CONFIG_KERN_STATELESS=y
