diff --git a/py/makeqstrdefs.py b/py/makeqstrdefs.py
index e1046fa2b..626db606a 100644
--- a/py/makeqstrdefs.py
+++ b/py/makeqstrdefs.py
@@ -39,6 +39,14 @@ def is_cxx_source(fname):
 
 
 def preprocess():
+    # A single @file argument is a response file with one source path per line.
+    # The CMake build uses this to keep the makeqstrdefs.py command line below
+    # the OS limit (MAX_ARG_STRLEN) when large usermods add thousands of
+    # sources (e.g. LVGL).
+    if len(args.sources) == 1 and args.sources[0].startswith("@"):
+        with open(args.sources[0][1:], "r", encoding="utf-8") as f:
+            args.sources = [line.strip() for line in f if line.strip()]
+
     if any(src in args.dependencies for src in args.changed_sources):
         sources = args.sources
     elif any(args.changed_sources):
diff --git a/py/mkrules.cmake b/py/mkrules.cmake
index 0903f81d8..4f85e75a8 100644
--- a/py/mkrules.cmake
+++ b/py/mkrules.cmake
@@ -122,11 +122,19 @@ add_custom_target(
 # If any of the dependencies in this rule change then the C-preprocessor step must be run.
 # It only needs to be passed the list of MICROPY_SOURCE_QSTR files that have changed since
 # it was last run, but it looks like it's not possible to specify that with cmake.
+# Pass the source list through a response file: with large usermods (LVGL has
+# >2000 sources) the expanded command line exceeds Linux's MAX_ARG_STRLEN
+# (128 KB), so the shell fails with E2BIG before makeqstrdefs.py runs.
+set(MICROPY_QSTR_SOURCES_LIST ${CMAKE_CURRENT_BINARY_DIR}/qstr_sources.txt)
+file(GENERATE OUTPUT ${MICROPY_QSTR_SOURCES_LIST}
+    CONTENT "$<JOIN:${MICROPY_SOURCE_QSTR},\n>\n")
+
 add_custom_command(
     OUTPUT ${MICROPY_QSTRDEFS_LAST}
-    COMMAND ${Python3_EXECUTABLE} ${MICROPY_PY_DIR}/makeqstrdefs.py pp ${CMAKE_C_COMPILER} -E output ${MICROPY_GENHDR_DIR}/qstr.i.last cflags ${MICROPY_CPP_FLAGS} -DNO_QSTR cxxflags ${MICROPY_CPP_FLAGS} -DNO_QSTR sources ${MICROPY_SOURCE_QSTR}
+    COMMAND ${Python3_EXECUTABLE} ${MICROPY_PY_DIR}/makeqstrdefs.py pp ${CMAKE_C_COMPILER} -E output ${MICROPY_GENHDR_DIR}/qstr.i.last cflags ${MICROPY_CPP_FLAGS} -DNO_QSTR cxxflags ${MICROPY_CPP_FLAGS} -DNO_QSTR sources @${MICROPY_QSTR_SOURCES_LIST}
     DEPENDS ${MICROPY_MPVERSION}
         ${MICROPY_SOURCE_QSTR}
+        ${MICROPY_QSTR_SOURCES_LIST}
     VERBATIM
     COMMAND_EXPAND_LISTS
 )
