@@ -106,6 +106,16 @@ image_plan_t esp_image_plan(const uint8_t *psram_buf, uint32_t payload_offset,
             IMAGE_FATAL_RETURN();
         }
 
+        // IDF 6.x appends a zero-address padding segment before the image
+        // signature block. It carries no loadable data, so skip it instead of
+        // rejecting the image as outside the P4/S3 memory windows.
+        if (seg.load_addr == 0 && seg.data_len > 0) {
+            ESP_LOGI(TAG, "Seg %d: padding block (%lu bytes), skipping",
+                     i, (unsigned long)seg.data_len);
+            offset += seg.data_len;
+            continue;
+        }
+
 #if CONFIG_IDF_TARGET_ESP32P4
