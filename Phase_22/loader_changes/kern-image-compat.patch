@@ -174,6 +184,13 @@ image_plan_t esp_image_plan(const uint8_t *psram_buf, uint32_t payload_offset,
             IMAGE_FATAL_RETURN();
         }
 
+        // Zero-address padding segment (IDF 6.x): already accounted for in the
+        // first pass, and has no destination in either memory window.
+        if (seg.load_addr == 0 && seg.data_len > 0) {
+            offset += seg.data_len;
+            continue;
+        }
+
         ESP_LOGI(TAG, "Seg %d: addr=0x%08lX len=%lu",
                  i, (unsigned long)seg.load_addr, (unsigned long)seg.data_len);
 
@@ -222,6 +239,35 @@ image_plan_t esp_image_plan(const uint8_t *psram_buf, uint32_t payload_offset,
                    (seg.load_addr >= 0x30100000 && seg.load_addr < 0x30102000) ||
                    /* LP RAM (SOC_LP_RAM 0x50108000-0x50110000, 32KB: rtc_noinit/sleep) */
                    (seg.load_addr >= 0x50108000 && seg.load_addr < 0x50110000)) {
+            // The loader's cache-off JMP code lives in RTC fast memory at
+            // _rtc_text_start.._rtc_text_end. A payload RTC/LP-RAM segment that
+            // lands on those bytes would overwrite the code that is currently
+            // copying it and derail the hand-off. Kern's only LP-RAM segment is
+            // sleep-mode state (sleep_modes.c .rtc.force_slow), not needed to
+            // boot, so skip overlapping segments with a loud warning. A payload
+            // that truly needs RTC state across stateless boot must be rejected
+            // here rather than silently losing it.
+#if CONFIG_IDF_TARGET_ESP32P4
+            {
+                extern char _rtc_text_start;
+                extern char _rtc_text_end;
+                uint32_t jmp_start = (uint32_t)(uintptr_t)&_rtc_text_start;
+                uint32_t jmp_end   = (uint32_t)(uintptr_t)&_rtc_text_end;
+                uint64_t seg_end64 = (uint64_t)seg.load_addr + seg.data_len;
+                if (seg_end64 > UINT32_MAX) {
+                    ESP_LOGE(TAG, "Segment %d end overflows. Halting.", i);
+                    IMAGE_FATAL_RETURN();
+                }
+                uint32_t seg_end = (uint32_t)seg_end64;
+                if (seg.load_addr < jmp_end && seg_end > jmp_start) {
+                    ESP_LOGW(TAG, "Segment %d (0x%08lX-0x%08lX) overlaps loader RTC JMP code (0x%08lX-0x%08lX); skipping RTC state copy.",
+                             i, (unsigned long)seg.load_addr, (unsigned long)seg_end,
+                             (unsigned long)jmp_start, (unsigned long)jmp_end);
+                    offset += seg.data_len;
+                    continue;
+                }
+            }
+#endif
             if (plan.copy_count >= MAX_DIRECT_COPIES) {
                 ESP_LOGE(TAG, "Exceeded MAX_DIRECT_COPIES (%d). Halting.", MAX_DIRECT_COPIES);
                 IMAGE_FATAL_RETURN();
